# ==============================================================================
# 💎 MONETRA FINANCIAL PLATFORM — PRODUCTION & VERCEL CONFIGURATION
# ==============================================================================
# Add these values in Vercel Project Settings > Environment Variables

# --- 1. Server Core Configuration ---
PORT=8000
BASE_PATH=/api
NODE_ENV=production

# --- 2. Frontend Origin (CORS Security) ---
# Replace with your deployed frontend URL (e.g. https://your-monetra-app.vercel.app):
FRONTEND_ORIGIN=http://localhost:5173

# --- 3. Authentication & JWT Security ---
JWT_SECRET=monetra_production_super_secure_jwt_secret_key_32_characters_minimum
JWT_REFRESH_SECRET=monetra_production_super_secure_jwt_refresh_secret_key_32_characters

# --- 4. Free PostgreSQL Database (Neon: https://neon.tech) ---
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- 5. AI Vision & Voice Classification (OpenAI or Gemini) ---
# Free trial keys or intelligent heuristic fallback if left empty:
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- 6. Cloud Image Storage (Optional - In-Memory Base64 fallback active) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
